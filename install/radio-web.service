[Unit]
Description=BL-WRA - interface web d'administration webradio
After=network.target liquidsoap-radio.service
Wants=liquidsoap-radio.service

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/opt/radio/app
Environment=RADIO_MEDIA_ROOT=/opt/radio/media
Environment=RADIO_SECRET_KEY=CHANGEZ-MOI
# Optionnel : protege un peu plus le webhook Liquidsoap -> Flask
# Environment=RADIO_WEBHOOK_TOKEN=un-secret-partage
ExecStart=/opt/radio/app/venv/bin/gunicorn -w 1 --threads 4 -b 0.0.0.0:5000 app:app
# Ecoute sur toutes les interfaces pour etre joignable depuis le reseau local
# (http://<nom-du-pi>.local:5000). Repassez a 127.0.0.1:5000 si vous mettez
# nginx devant (voir install/nginx-radio.conf) pour ne pas exposer gunicorn
# directement.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
