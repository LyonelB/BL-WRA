# BL-WRA - permet a l'utilisateur systeme "radio" (celui qui fait tourner
# radio-web.service) d'executer, sans mot de passe et uniquement ces
# commandes precises :
#   - redemarrer liquidsoap-radio.service : bouton "Redemarrer Liquidsoap
#     maintenant" (Reglages -> Traitement audio), pour appliquer le fondu
#     enchaine (crossfade) sans avoir a se connecter en SSH.
#   - activer/desactiver le timer de redemarrage preventif quotidien :
#     bascule "Redemarrage automatique a 4h du matin" (Reglages ->
#     Fiabilite), voir liquidsoap-radio-restart.timer.
#
# Installe automatiquement par install.sh (copie vers
# /etc/sudoers.d/radio-wra, permissions 0440). Sur une installation
# existante mise a jour via deploy.sh, copiez-le vous-meme une fois :
#   sudo cp install/radio-sudoers /etc/sudoers.d/radio-wra
#   sudo chmod 0440 /etc/sudoers.d/radio-wra
#   sudo visudo -c
radio ALL=(root) NOPASSWD: /usr/bin/systemctl restart liquidsoap-radio
radio ALL=(root) NOPASSWD: /usr/bin/systemctl enable --now liquidsoap-radio-restart.timer
radio ALL=(root) NOPASSWD: /usr/bin/systemctl disable --now liquidsoap-radio-restart.timer
